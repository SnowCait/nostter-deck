{
	"name": "nostter-deck",
	"version": "0.1.0",
	"description": "",
	"type": "module",
	"packageManager": "npm@11.15.0",
	"engines": {
		"node": ">=24.14.0",
		"npm": ">=11.10.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"tauri:update": "npm update && cd src-tauri && cargo update",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:e2e": "playwright install && playwright test",
		"test": "npm run test:unit && npm run test:e2e",
		"test:desktop": "wdio run ./wdio.conf.js"
	},
	"dependencies": {
		"@nostter/nostr-protocol": "0.1.0",
